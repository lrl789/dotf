set hlsearch
set incsearch

set clipboard=unamedplus

set tabstop=4
set softtabstop=4
set shiftwidth=4

set autoindent
set fileformat=unix

syntax on

set encoding=utf-8

set number relativenumber

nnoremap <Up> k 
nnoremap <Down> j
nnoremap <Left> h
nnoremap <Right> l

nnoremap <n> 0
nnoremap <m> $
