general.import = [
  "/usr/lib/node_modules/alacritty-themes/themes/3024.dark.toml"
]


[window]
opacity = 0.7

  [window.dimensions]
  columns = 100
  lines = 30

  [window.padding]
  x = 6
  y = 6

[font]
size = 10

  [font.normal]
  family = "FreeMono"
  style = "Regular"

[colors.primary]
foreground = "#ffffff"
background = "#000000"

[[keyboard.bindings]]
key = "V"
mods = "Control|Shift"
action = "Paste"

[[keyboard.bindings]]
key = "C"
mods = "Control|Shift"
action = "Copy"
